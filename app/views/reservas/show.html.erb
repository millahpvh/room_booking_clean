<% content_for :title, "Detalhes da reserva" %>

<% if notice.present? %>
  <p class="mensagem-sucesso"><%= notice %></p>
<% end %>

<h1>Detalhes da reserva</h1>

<%= render @reserva %>

<div class="acoes-pagina">
  <%= link_to "Editar reserva",
              edit_reserva_path(@reserva),
              class: "botao botao-primario" %>

  <%= link_to "Voltar para reservas",
              reservas_path,
              class: "botao botao-secundario" %>

  <%= button_to "Excluir reserva",
                @reserva,
                method: :delete,
                class: "botao botao-perigo",
                form: {
                  data: {
                    turbo_confirm: "Tem certeza que deseja excluir esta reserva?"
                  }
                } %>
</div>