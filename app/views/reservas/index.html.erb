<% content_for :title, "Reservas" %>

<% if notice.present? %>
  <p class="mensagem-sucesso"><%= notice %></p>
<% end %>

<div class="cabecalho-pagina">
  <h1>Reservas</h1>

  <%= link_to "Nova reserva",
              new_reserva_path,
              class: "botao botao-primario" %>
</div>

<div id="reservas" class="lista-registros">
  <% @reservas.each do |reserva| %>
  <%= render reserva, mostrar_detalhes: true %>
<% end %>
</div>