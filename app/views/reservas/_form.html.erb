<%= form_with(model: reserva, class: "formulario") do |form| %>
  <% if reserva.errors.any? %>
    <div class="mensagem-erro">
      <h2>Não foi possível salvar esta reserva:</h2>

      <ul>
        <% reserva.errors.each do |erro| %>
          <li><%= erro.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="campo-formulario">
    <%= form.label :responsavel, "Responsável" %>
    <%= form.text_field :responsavel %>
  </div>

  <div class="campo-formulario">
    <%= form.label :assunto, "Assunto" %>
    <%= form.text_field :assunto %>
  </div>

  <div class="campo-formulario">
    <%= form.label :inicio, "Início" %>
    <%= form.datetime_field :inicio %>
  </div>

  <div class="campo-formulario">
    <%= form.label :fim, "Fim" %>
    <%= form.datetime_field :fim %>
  </div>

  <div class="campo-formulario">
    <%= form.label :sala_id, "Sala" %>
    <%= form.collection_select :sala_id,
                               Sala.all,
                               :id,
                               :nome,
                               prompt: "Selecione uma sala" %>
  </div>

  <div class="acoes-formulario">
    <%= form.submit(reserva.persisted? ? "Atualizar reserva" : "Cadastrar reserva",
                    class: "botao botao-primario") %>
  </div>
<% end %>
