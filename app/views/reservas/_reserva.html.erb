<div id="<%= dom_id reserva %>">
  <p>
    <strong>Responsável:</strong>
    <%= reserva.responsavel %>
  </p>

  <p>
    <strong>Assunto:</strong>
    <%= reserva.assunto %>
  </p>

  <p>
    <strong>Início:</strong>
    <%= reserva.inicio&.strftime("%d/%m/%Y às %H:%M") %>
  </p>

  <p>
    <strong>Fim:</strong>
    <%= reserva.fim&.strftime("%d/%m/%Y às %H:%M") %>
  </p>

  <p>
    <strong>Sala:</strong>
    <%= reserva.sala.nome %>
  </p>

<% if local_assigns[:exibir_campos_extras] %>
  <% if reserva.participantes.present? %>
    <div class="detalhe-adicional">
      <strong>Participantes:</strong>
      <%= simple_format(reserva.participantes) %>
    </div>
  <% end %>

  <% if reserva.observacoes.present? %>
    <div class="detalhe-adicional">
      <strong>Observações:</strong>
      <%= simple_format(reserva.observacoes) %>
    </div>
  <% end %>
<% end %>

  <% if local_assigns[:mostrar_detalhes] %>
    <div class="acoes-card">
      <%= link_to "Ver detalhes",
                  reserva,
                  class: "botao botao-secundario" %>
    </div>
  <% end %>
</div>