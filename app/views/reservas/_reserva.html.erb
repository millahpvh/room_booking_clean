<div id="<%= dom_id reserva %>">
  <p>
    <strong>Responsável:</strong>
    <%= reserva.responsavel %>
  </p>

  <p>
    <strong>Assunto:</strong>
    <%= reserva.assunto %>
  </p>

  <p>
    <strong>Início:</strong>
    <%= reserva.inicio&.strftime("%d/%m/%Y às %H:%M") %>
  </p>

  <p>
    <strong>Fim:</strong>
    <%= reserva.fim&.strftime("%d/%m/%Y às %H:%M") %>
  </p>

  <p>
    <strong>Sala:</strong>
    <%= reserva.sala.nome %>
  </p>

  <% if local_assigns[:mostrar_detalhes] %>
    <div class="acoes-card">
      <%= link_to "Ver detalhes",
                  reserva,
                  class: "botao botao-secundario" %>
    </div>
  <% end %>
</div>