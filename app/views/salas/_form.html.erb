<%= form_with(model: sala, class: "formulario") do |form| %>
  <% if sala.errors.any? %>
    <div class="mensagem-erro">
      <h2>Não foi possível salvar esta sala:</h2>

      <ul>
        <% sala.errors.each do |erro| %>
          <li><%= erro.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="campo-formulario">
    <%= form.label :nome, "Nome" %>
    <%= form.text_field :nome %>
  </div>

  <div class="campo-formulario">
    <%= form.label :capacidade, "Capacidade" %>
    <%= form.number_field :capacidade %>
  </div>

  <div class="campo-formulario">
    <%= form.label :localizacao, "Localização" %>
    <%= form.text_field :localizacao %>
  </div>

  <div class="acoes-formulario">
    <%= form.submit(sala.persisted? ? "Atualizar sala" : "Cadastrar sala",
                    class: "botao botao-primario") %>
  </div>
<% end %>