<div id="<%= dom_id sala %>">
  <div>
    <strong>Nome:</strong>
    <%= sala.nome %>
  </div>

  <div>
    <strong>Capacidade:</strong>
    <%= sala.capacidade %>
  </div>

  <div>
    <strong>Localização:</strong>
    <%= sala.localizacao %>
  </div>

  <% if local_assigns[:mostrar_detalhes] %>
    <div class="acoes-card">
      <%= link_to "Ver detalhes",
                  sala,
                  class: "botao botao-secundario" %>
    </div>
  <% end %>
</div>
