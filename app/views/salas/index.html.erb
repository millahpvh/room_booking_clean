<% content_for :title, "Salas" %>

<% if notice.present? %>
  <p class="mensagem-sucesso"><%= notice %></p>
<% end %>

<div class="cabecalho-pagina">
  <h1>Salas</h1>

  <%= link_to "Nova sala",
              new_sala_path,
              class: "botao botao-primario" %>
</div>

<% if @salas.any? %>
  <div id="salas" class="lista-registros">
    <% @salas.each do |sala| %>
      <%= render sala, mostrar_detalhes: true %>
    <% end %>
  </div>
<% else %>
  <div class="estado-vazio">
    <h2>Nenhuma sala cadastrada</h2>
    <p>Cadastre uma sala antes de criar as primeiras reservas.</p>

    <%= link_to "Cadastrar primeira sala",
                new_sala_path,
                class: "botao botao-primario" %>
  </div>
<% end %>