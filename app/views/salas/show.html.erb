<% content_for :title, "Detalhes da sala" %>

<% if notice.present? %>
  <p class="mensagem-sucesso"><%= notice %></p>
<% end %>

<h1>Detalhes da sala</h1>

<%= render @sala %>

<div class="acoes-pagina">
  <%= link_to "Editar sala",
              edit_sala_path(@sala),
              class: "botao botao-primario" %>

  <%= link_to "Voltar para salas",
              salas_path,
              class: "botao botao-secundario" %>

  <%= button_to "Excluir sala",
                @sala,
                method: :delete,
                class: "botao botao-perigo",
                form: {
                  data: {
                    turbo_confirm: "Tem certeza que deseja excluir esta sala?"
                  }
                } %>
</div>
